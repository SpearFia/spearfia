{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spearfia.dev/schemas/production-pipeline/v1.json",
  "title": "Spear Fia production-pipeline",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spec_version": {
      "const": 1
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "agent": {
            "type": "object",
            "properties": {
              "provider": {
                "enum": [
                  "claude",
                  "codex"
                ]
              },
              "executable": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "effort": {
                "type": "string"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "network": {
                "type": "boolean",
                "default": false,
                "description": "Let the agent's commands reach the network (Codex sandboxes block it by default)."
              },
              "writable_dirs": {
                "type": "array",
                "maxItems": 16,
                "items": {"type": "string", "minLength": 1, "maxLength": 4096},
                "default": [],
                "description": "Absolute folders outside the project the agent may write, e.g. a shared media library."
              }
            },
            "required": [
              "provider",
              "executable",
              "model",
              "effort",
              "timeout_seconds"
            ],
            "additionalProperties": true
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "production": {
            "type": "boolean"
          },
          "review": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "file",
                    "script",
                    "visuals",
                    "links",
                    "filmcraft",
                    "jobs",
                    "alignment",
                    "captions"
                  ]
                },
                "path": {
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "a-roll",
                    "voiceover",
                    "b-roll",
                    "screen",
                    "graphics",
                    "music",
                    "sfx",
                    "other"
                  ]
                },
                "minimum": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5000
                },
                "coverage": {
                  "type": "boolean"
                },
                "stage": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": true,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "file"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 65536
                      }
                    },
                    "required": [
                      "path"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "links"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "role": {},
                      "minimum": {},
                      "coverage": {}
                    },
                    "required": [
                      "role",
                      "minimum",
                      "coverage"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "jobs"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "stage": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "stage"
                    ]
                  }
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "title",
          "agent",
          "prompt",
          "production",
          "review",
          "checks"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "spec_version",
    "stages"
  ],
  "additionalProperties": true
}
