{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spearfia.dev/schemas/production-report/v1.json",
  "title": "Spear Fia production-report",
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "completed",
        "needs_input",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "question": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "summary",
    "question"
  ],
  "additionalProperties": false
}
