{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spearfia.dev/schemas/production-run/v1.json",
  "title": "Spear Fia production-run",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "spec_version": {
      "const": 1
    },
    "pipeline_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "state": {
      "enum": [
        "pending",
        "running",
        "needs-input",
        "review",
        "complete",
        "failed",
        "cancelled"
      ]
    },
    "message": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "needs-input",
              "review",
              "complete",
              "failed",
              "cancelled"
            ]
          },
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string"
          },
          "reply": {
            "type": "string"
          },
          "log": {
            "type": "string"
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "state",
          "attempts",
          "message",
          "reply",
          "artifacts"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "spec_version",
    "pipeline_revision",
    "state",
    "message",
    "steps"
  ],
  "additionalProperties": true
}
