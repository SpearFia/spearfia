{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spearfia.dev/schemas/timeline-plan/v1.json",
  "title": "Spear Fia timeline plan (pushed to the editor)",
  "type": "object",
  "required": [
    "timebase",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "base_snapshot": {
      "type": "string",
      "description": "ID of the last-synced snapshot this plan was compiled against"
    },
    "timebase": {
      "type": "object",
      "required": [
        "num",
        "den"
      ],
      "properties": {
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "den": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true,
      "description": "Rational frame rate, e.g. 60000/1001 for 59.94 fps"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cue_id",
          "kind",
          "track",
          "start_frame",
          "duration_frames"
        ],
        "properties": {
          "cue_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Script cue ID ({#id}); stored in the editor item's metadata"
          },
          "kind": {
            "enum": [
              "clip",
              "transition",
              "effect",
              "music",
              "sfx",
              "title"
            ]
          },
          "track": {
            "type": "string",
            "description": "V1, V2, ... or A1, A2, ...; tracks the sequence lacks are created. An item on a V track uses the source's picture only, on an A track its sound only."
          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 0,
            "description": "For a transition, 0 means the editor's default length"
          },
          "source": {
            "type": "object",
            "required": [],
            "properties": {
              "path": {
                "type": "string"
              },
              "asset": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*@\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
              },
              "in_frame": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          },
          "apply": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*(@\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?)?#[a-z0-9][a-z0-9.-]*$",
            "description": "Capability to apply (effects and looks)"
          },
          "params": {
            "type": "object",
            "description": "Free-form per kind. A transition's params: effect (editor transition ID, e.g. cross_dissolve), attach (cue_id of the clip it sits on), edge (in or out, default in)."
          },
          "intent": {
            "type": "object",
            "required": [],
            "properties": {
              "start_frame": {
                "type": "integer",
                "minimum": 0
              },
              "duration_frames": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true,
            "description": "Timing the script asked for, kept separate from the actual timing"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "transition"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "type": "object",
              "required": [
                "params"
              ],
              "properties": {
                "params": {
                  "type": "object",
                  "required": [
                    "effect",
                    "attach"
                  ],
                  "properties": {
                    "effect": {
                      "type": "string",
                      "minLength": 1
                    },
                    "attach": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    },
                    "edge": {
                      "enum": [
                        "in",
                        "out"
                      ]
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "description": "Applied in array order to a fresh sequence, all or nothing: an editor adapter either realizes every item or leaves no result."
    }
  },
  "additionalProperties": true,
  "$comment": "TODO: base_snapshot format and pull semantics (ADR 0005 in spearfia covers the push only)."
}
